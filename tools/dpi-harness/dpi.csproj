<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not part of the solution and not referenced by anything shipped. It exists to be run by hand on a
    machine that has the displays a CI runner does not.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The same PerMonitorV2 the app declares. Measuring through any other awareness mode measures
         Windows' coordinate virtualisation instead of the layout. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>dpicheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\windows\DoNotType.App\DoNotType.App.csproj" />
  </ItemGroup>

</Project>
